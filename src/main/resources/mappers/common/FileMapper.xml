<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.consumingrest.common.mapper.FileMapper">

    <select id="list" resultType="hashmap">
        SELECT A.path,
        	   A.api_compent,
        	   B.* 
          FROM file A, file_detail B
         WHERE A.seq = B.seq 
         ORDER BY A.seq DESC, B.no ASC
    </select>
    
    <select id="apiFileList" resultType="hashmap">
        SELECT * 
          FROM file_detail
         WHERE seq = #{seq}
         ORDER BY no ASC
    </select>
    
    <select id="one" parameterType="hashmap" resultType="map">
        SELECT * 
          FROM file 
         WHERE name LIKE '%' || #{name}  || '%'
    </select>
    
    <insert id="insert" parameterType="hashmap">
        <selectKey keyProperty="seq" resultType="int" order="AFTER">
        SELECT CURRVAL('file_seq')
        </selectKey>
        INSERT INTO file
        	(path, 
        	 <if test='api_compent != null and api_compent != ""'>
        	 api_compent,
        	 </if>
        	 reg_date) 
        VALUES
        	(#{path},
        	 <if test='api_compent != null and api_compent != ""'>
        	 #{api_compent},
        	 </if>
        	 NOW())
    </insert>
    
    <update id="delete" parameterType="String">
        DELETE FROM file_detail
        WHERE name = #{name}  
    </update>
    
    <insert id="detailInsert" parameterType="hashmap">
        INSERT INTO file_detail
        	(seq,
        	 no,
        	 name,
        	 extents,
        	 size,
        	 reg_date)
        VALUES
        	(#{seq},
        	 (SELECT COALESCE(MAX(no)+1, 1) FROM file_detail WHERE seq = #{seq}),
        	 #{name},
        	 #{extents},
        	 #{size},
        	 NOW())	  
    </insert>
    
    <update id="detailDelete" parameterType="hashmap">
        DELETE FROM file_detail
        WHERE seq = #{seq}  
    </update>
    
</mapper>