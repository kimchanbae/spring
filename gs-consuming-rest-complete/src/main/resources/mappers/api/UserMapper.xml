<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.consumingrest.api.mapper.UserMapper">

    <select id="selectList" resultType="hashmap">
        SELECT * 
          FROM member
         ORDER BY reg_date DESC
    </select>
    
    <select id="selectOne" parameterType="hashmap" resultType="map">
        SELECT * 
          FROM member 
         WHERE id = #{id}
    </select>
    
    <insert id="insert" parameterType="hashmap">
        INSERT INTO member
        	(id, 
        	 name, 
        	 content, 
        	 reg_date) 
        VALUES
        	(#{id}, 
        	 #{name}, 
        	 #{content}, 
        	 NOW())
    </insert>
    
    <update id="update" parameterType="hashmap">
        UPDATE member SET
        	name = #{name},
        	content = #{content}, 
        	upd_date = NOW()
        WHERE id = #{id}  
    </update>
    
    <update id="delite" parameterType="hashmap">
        DELETE FROM member
        WHERE id = #{id}  
    </update>
    
</mapper>