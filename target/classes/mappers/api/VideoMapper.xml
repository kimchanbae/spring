<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.consumingrest.api.mapper.VideoMapper">

    <select id="list" resultType="hashmap">
        SELECT * 
          FROM video
         WHERE 1=1
         <if test='title != null and title != ""'>
         AND title LIKE '%' || #{title} || '%'
         </if> 
         <if test='comment != null and comment != ""'>
         AND comment LIKE '%' || #{comment} || '%'
         </if>
         <if test='actor != null and actor != ""'>
         AND actor LIKE '%' || #{actor} || '%'
         </if>
         ORDER BY reg_date DESC
    </select>
    
    <select id="one" parameterType="hashmap" resultType="map">
        SELECT * 
          FROM video 
         WHERE seq = #{seq}
    </select>
    
    <insert id="insert" parameterType="hashmap">
        INSERT INTO video
        	(title, 
        	 comment,
        	 producets,
        	 actor, 
        	 reg_date) 
        VALUES
        	(#{title}, 
        	 #{comment},
        	 #{producets},
        	 #{actor} 
        	 NOW())
    </insert>
    
    <update id="update" parameterType="hashmap">
        UPDATE video SET
        	title = #{title},
        	comment = #{comment},
        	producets = #{producets},
        	actor = #{actor} 
        	upd_date = NOW()
        WHERE id = #{id}  
    </update>
    
    <update id="delite" parameterType="hashmap">
        DELETE FROM video
        WHERE seq = #{seq}  
    </update>
    
</mapper>